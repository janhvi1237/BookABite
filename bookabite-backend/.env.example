# Copy to ".env" and fill in. Never commit the real .env.

# Database: "windows" = Windows Authentication, "sql" = username/password
DB_AUTH=windows
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=BookABiteDB
DB_DRIVER=ODBC Driver 17 for SQL Server
# Only needed when DB_AUTH=sql
# DB_USER=
# DB_PASSWORD=

# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Razorpay TEST keys only (https://dashboard.razorpay.com -> Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 1 = auto-reload + debugger (local development only)
FLASK_DEBUG=1

# Booking fee (INR). Fee = per guest x guests, up to the max.
BOOKING_FEE_PER_GUEST=50
BOOKING_FEE_MAX=500
# Guests get the fee back if they cancel at least this many minutes before the booking
BOOKING_REFUND_CUTOFF_MINUTES=60
